{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Call Center",
  "version": "0.1.0",
  "identifier": "com.callcenter.game",
  "build": {
    "frontendDist": "../client/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix client run dev",
    "beforeBuildCommand": "npm --prefix client run build"
  },
  "app": {
    "windows": [
      { "title": "Call Center", "width": 1280, "height": 720, "resizable": true, "fullscreen": false }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
